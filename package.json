{
  "name": "dsh-kb-sync",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: run and monitor any user-owned sync pipeline from a local control page — status, logs, and an integrity check. The plugin itself holds no credentials and makes no network calls; both stay inside the pipeline it spawns.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "knowledge-base",
    "sync",
    "orchestration"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/284022719/dsh-kb-sync.git"
  }
}
